# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexoglobal?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# CORS Allowed Origins (Comma-separated for frontend domains)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Keep-Alive URL for Render Free Tier
# (Render automatically sets RENDER_EXTERNAL_URL in production, or you can provide BACKEND_URL)
BACKEND_URL=https://your-backend-app.onrender.com

# Optional Integrations
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_PASSWORD=
